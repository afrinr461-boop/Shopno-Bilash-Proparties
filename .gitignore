# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets, never committed. `.env.example` is the one
# exception: a template with no actual values, meant to be committed so
# anyone cloning the repo knows which variables to set.
.env*
!.env.example

# local SQLite database (prisma/schema.prisma) — real data, never committed.
# Matched at any depth (not just /prisma/dev.db) because DATABASE_URL's
# relative path currently resolves one level deeper in some setups
# (prisma/prisma/dev.db) — this pattern must catch it wherever it lands.
**/dev.db
**/dev.db-journal

# uploaded documents (src/lib/fileStorage.ts) — real customer files (NIDs,
# deeds, agreements), never committed; keep the folder itself tracked
/public/uploads/*
!/public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
