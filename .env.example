# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit actual secrets.

# The database (prisma/schema.prisma). Already set in .env for local dev
# (a SQLite file at prisma/dev.db, created by `npx prisma migrate deploy`)
# — only override this if you're pointing at a different database, e.g.
# Postgres in production: DATABASE_URL="postgresql://user:pass@host/db"
# DATABASE_URL=

# Session signing secret (Admin Step 3, src/lib/auth/session.ts).
# Required. Must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The one bootstrap admin account (src/lib/auth/credentials.ts) — the
# minimal way to actually sign in before a real `users` database exists.
# ADMIN_BOOTSTRAP_PASSWORD_HASH must be a hash produced by
# src/lib/auth/password.ts's hashPassword(), never a plaintext password.
# Generate one with:
#   node scripts/hash-password.mjs "your-new-password"
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# Set automatically by most hosting platforms; only affects the session
# cookie's `Secure` flag (src/lib/auth/session.ts). Leave unset for local
# development over http://localhost.
# NODE_ENV=production

# Off by default, everywhere, on purpose — the "Continue as Owner (dev)" /
# "Continue as Super Admin (dev)" one-click login buttons (src/lib/auth/
# actions.ts, ownerActions.ts) only appear/work when this is explicitly set
# to "true" AND NODE_ENV isn't "production". Leave unset (or "false") on a
# real deployment and in any shared .env.local — only turn it on in your
# own untracked local file, and only while you're actively testing.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
