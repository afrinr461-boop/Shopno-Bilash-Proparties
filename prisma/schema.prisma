// Real, on-disk persistence for every domain that used to live only in
// server memory (`InMemoryRepository` — see `src/lib/repository.ts`).
//
// Every model below (bar `Credential`) has exactly the same shape: an `id`
// column to query/update/delete by, and a `data` JSON column holding the
// *entire* entity exactly as the app's own `src/types/*` TypeScript types
// already define it. This is deliberate, not a shortcut:
//
//   - The `Repository<T>` interface (`src/lib/repository.ts`) only ever
//     does `list()` / `findById()` / `create()` / `update()` / `remove()` —
//     no filtering, no joins, no query language. Every "join" in this app
//     already happens in JS, at the page level, after fetching full lists.
//     A normalized relational schema would add real column types and
//     foreign keys that nothing in the app would ever actually query by —
//     pure risk (an app type and a DB column silently drifting apart)
//     for zero benefit today.
//   - Storing the whole entity as JSON means `toEntity`/`toRow` in
//     `src/lib/prismaRepository.ts` are the same two lines for all 29
//     models — one implementation to get right, not 29 field-by-field
//     mappings (Money objects, string[] arrays, optional fields, etc.)
//     each a fresh chance to introduce a bug.
//   - Upgrading any one domain to real relational columns later (once the
//     app actually needs to filter/sort at the database level) is a
//     schema change to that one model plus a matching `toEntity`/`toRow`
//     pair — the `Repository<T>` interface, and every caller, stays
//     exactly the same, per this project's established swap-the-
//     implementation architecture.
//
// SQLite today (`DATABASE_URL` in `.env`) so this runs with zero external
// infrastructure. Moving to Postgres later for production is a one-line
// `provider` change plus a connection string — Prisma's whole reason for
// existing — nothing else in this schema or the app changes.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// The one exception to the id+data pattern: password hashes must never
// travel through the same read path as a `User` record (see
// `src/lib/auth/credentials.ts`'s own comment on this separation), so they
// get their own tiny table instead of living in `User.data`.
model Credential {
  userId       String @id
  email        String @unique
  passwordHash String
}

// Chapter 3 — the owner/shareholder/landowner portal's phone+PIN login,
// same separation-of-concerns reasoning as `Credential` above (a PIN hash
// must never travel through `User`'s normal read path). A row here only
// ever exists once an owner has actually activated their portal access —
// its absence for a given `User` IS the "Pending Activation" state, not a
// separate stored status.
model OwnerCredential {
  userId    String   @id
  phone     String   @unique
  pinHash   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

